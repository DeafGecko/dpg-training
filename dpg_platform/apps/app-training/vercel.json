{
  "buildCommand": "npm run export:web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [{ "source": "/", "destination": "/login" }],
  "headers": [
    {
      "source": "/_expo/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
